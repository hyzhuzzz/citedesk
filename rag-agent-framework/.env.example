# ---------------------------------------------------------------------------
# LLM (used by the OpenAI Agents SDK for all conversation generation)
# ---------------------------------------------------------------------------
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=
LLM_MODEL=your-chat-model-name

# ---------------------------------------------------------------------------
# Embedding (used by LlamaIndex only for vectorising documents and queries)
# Leave the key/base URL empty to reuse the LLM settings above.
# ---------------------------------------------------------------------------
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=your-embedding-model-name

# ---------------------------------------------------------------------------
# Audit database. Default: local SQLite with WAL enabled.
# To switch to PostgreSQL, change only this line, e.g.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/citedesk
# ---------------------------------------------------------------------------
DATABASE_URL=

# Optional: minimum cosine score for a chunk to be considered relevant.
SCORE_THRESHOLD=0.45
